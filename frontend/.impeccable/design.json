  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Navy fill for the main action: Finish cook, End cook.",
      "html": "<button class=\"ds-btn-primary\">Finish cook</button>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-btn-primary{min-height:48px;padding:0 20px;border:none;border-radius:10px;background:var(--tide-ink);color:var(--tide-ground);font:700 16px Archivo,system-ui,sans-serif;cursor:pointer;}.ds-btn-primary:hover{opacity:.9;}.ds-btn-primary:focus-visible{outline:2px solid var(--tide-blue);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ring-only button for the safe choice, such as Keep cooking.",
      "html": "<button class=\"ds-btn-secondary\">Keep cooking</button>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-btn-secondary{min-height:48px;padding:0 20px;border:none;border-radius:10px;background:transparent;color:var(--tide-ink);box-shadow:0 0 0 1.5px var(--tide-rule);font:600 16px Archivo,system-ui,sans-serif;cursor:pointer;}.ds-btn-secondary:hover{box-shadow:0 0 0 1.5px var(--tide-ink);}.ds-btn-secondary:focus-visible{outline:2px solid var(--tide-blue);outline-offset:2px;}"
    },
    {
      "name": "Pull Alarm",
      "kind": "custom",
      "refersTo": "band-pull",
      "description": "The red band takeover with the pull action and silence toggle.",
      "html": "<div class=\"ds-pull\" role=\"alert\"><p class=\"ds-pull-head\">Pull now</p><p class=\"ds-pull-text\">Core is 94°. Expect it to coast about 3° higher during the rest.</p><div class=\"ds-pull-row\"><button class=\"ds-btn-pull\">I pulled it, start rest</button><button class=\"ds-btn-silence\" aria-label=\"Silence alarm\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M155.51,24.81a8,8,0,0,0-8.42.88L77.25,80H32A16,16,0,0,0,16,96v64a16,16,0,0,0,16,16H77.25l69.84,54.31A8,8,0,0,0,160,224V32A8,8,0,0,0,155.51,24.81ZM144,207.64,84.91,161.69A7.94,7.94,0,0,0,80,160H32V96H80a7.94,7.94,0,0,0,4.91-1.69L144,48.36Z\"/></svg></button></div></div>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-pull{background:var(--tide-pull);color:var(--tide-on-pull);padding:20px 20px 24px;animation:ds-in 520ms cubic-bezier(0.16,1,0.3,1) both;}@keyframes ds-in{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 0 0)}}@media (prefers-reduced-motion:reduce){.ds-pull{animation:none}}.ds-pull-head{margin:0;font-size:clamp(3.75rem,17vw,6rem);font-weight:800;line-height:.88;letter-spacing:-0.02em;font-stretch:66%;}.ds-pull-text{margin:12px 0 0;max-width:42ch;font-size:16px;line-height:1.375;}.ds-pull-row{display:flex;gap:12px;margin-top:20px;}.ds-btn-pull{min-height:56px;padding:0 20px;border:none;border-radius:10px;background:var(--tide-on-pull);color:var(--tide-pull);font:700 17px Archivo,system-ui,sans-serif;cursor:pointer;transition:transform 150ms;}.ds-btn-pull:active{transform:scale(.98);}.ds-btn-silence{width:56px;min-height:56px;display:flex;align-items:center;justify-content:center;border:none;border-radius:10px;background:transparent;color:inherit;box-shadow:0 0 0 1.5px rgb(255 247 245 / .7);cursor:pointer;}.ds-btn-pull:focus-visible,.ds-btn-silence:focus-visible{outline:2px solid var(--tide-on-pull);outline-offset:2px;}"
    },
    {
      "name": "Cook Band",
      "kind": "custom",
      "refersTo": "band",
      "description": "The almanac-yellow header with the cook name and overflow menu.",
      "html": "<header class=\"ds-band\"><h1 class=\"ds-band-title\">Brisket · 5.4 kg · Offset</h1><button class=\"ds-band-menu\" aria-label=\"Cook options\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><circle cx=\"128\" cy=\"60\" r=\"16\"/><circle cx=\"128\" cy=\"128\" r=\"16\"/><circle cx=\"128\" cy=\"196\" r=\"16\"/></svg></button></header>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-band{display:flex;justify-content:space-between;align-items:flex-start;padding:18px 20px 16px;background:var(--tide-band);color:var(--tide-on-band);transition:background-color 420ms cubic-bezier(0.16,1,0.3,1),color 420ms cubic-bezier(0.16,1,0.3,1);}.ds-band-title{margin:0;padding-top:8px;font-size:17px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-band-menu{width:44px;height:44px;margin-right:-8px;display:flex;align-items:center;justify-content:center;border:none;border-radius:9999px;background:transparent;color:inherit;cursor:pointer;}.ds-band-menu:hover{background:rgb(19 35 58 / .08);}.ds-band-menu:focus-visible{outline:2px solid var(--tide-blue);outline-offset:2px;}"
    },
    {
      "name": "Core Readout",
      "kind": "custom",
      "refersTo": "",
      "description": "Core temperature at specimen size beside the pull target.",
      "html": "<section class=\"ds-readout\"><div class=\"ds-readout-row\"><p class=\"ds-figure\">168°</p><p class=\"ds-target\">Pull at 200°</p></div><p class=\"ds-note\">Smoothed reading, updated 12 s ago</p></section>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-readout{background:var(--tide-ground);color:var(--tide-ink);padding:20px;}.ds-readout-row{display:flex;align-items:flex-end;gap:16px;}.ds-figure{margin:0;font-size:clamp(5.5rem,27vw,8.5rem);font-weight:800;line-height:.8;letter-spacing:-0.02em;font-stretch:66%;}.ds-target{margin:0 0 4px;white-space:nowrap;font-size:clamp(1.4rem,6vw,1.75rem);font-weight:700;line-height:1.25;font-stretch:80%;}.ds-note{margin:12px 0 0;font-size:15px;color:var(--tide-muted);}"
    },
    {
      "name": "Forecast Table",
      "kind": "custom",
      "refersTo": "",
      "description": "Tide-table rows: event left, time large right, pull value in red.",
      "html": "<dl class=\"ds-table\"><div class=\"ds-row\"><dt>Pull at</dt><dd class=\"ds-val ds-val-pull\">200°</dd></div><div class=\"ds-row\"><dt>Ready around</dt><dd class=\"ds-val\">4:40 PM</dd><dd class=\"ds-rnote\">about 3 h 10 min</dd></div></dl>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-table{margin:0;padding:0 20px;background:var(--tide-ground);color:var(--tide-ink);}.ds-table .ds-row{display:grid;grid-template-columns:1fr auto;align-items:baseline;column-gap:16px;padding:12px 0;border-bottom:1px solid var(--tide-rule);}.ds-table .ds-row:first-child{border-top:1.5px solid var(--tide-ink);}.ds-table dt{font-size:15px;font-weight:500;}.ds-table dd{margin:0;}.ds-val{text-align:right;font-size:28px;font-weight:700;line-height:1;font-stretch:76%;}.ds-val-pull{color:var(--tide-pull);}.ds-rnote{grid-column-start:2;margin-top:4px!important;text-align:right;font-size:13px;color:var(--tide-muted);}"
    },
    {
      "name": "Tide Chart",
      "kind": "custom",
      "refersTo": "",
      "description": "Signature: solid past, dashed projection with no range band, right-gutter scale, now hairline, red pull line drawn last.",
      "html": "<figure class=\"ds-chart\"><svg width=\"340\" height=\"210\" viewBox=\"0 0 340 210\"><line x1=\"0\" y1=\"50\" x2=\"304\" y2=\"50\" stroke=\"var(--tide-rule)\" opacity=\".6\"/><text x=\"340\" y=\"54\" text-anchor=\"end\" font-size=\"11\" fill=\"var(--tide-muted)\">200</text><line x1=\"0\" y1=\"120\" x2=\"304\" y2=\"120\" stroke=\"var(--tide-rule)\" opacity=\".6\"/><text x=\"340\" y=\"124\" text-anchor=\"end\" font-size=\"11\" fill=\"var(--tide-muted)\">150</text><path d=\"M170,92 C220,92 250,40 290,36\" fill=\"none\" stroke=\"var(--tide-blue)\" stroke-width=\"2.5\" stroke-dasharray=\"7 5\" stroke-linecap=\"round\"/><path d=\"M0,170 C50,140 90,100 120,96 L170,92\" fill=\"none\" stroke=\"var(--tide-ink)\" stroke-width=\"2.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"0\" y1=\"44\" x2=\"304\" y2=\"44\" stroke=\"var(--tide-pull)\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><text x=\"0\" y=\"37\" font-size=\"12\" font-weight=\"600\" fill=\"var(--tide-pull)\">Pull 200°</text><line x1=\"170\" y1=\"6\" x2=\"170\" y2=\"184\" stroke=\"var(--tide-ink)\"/><text x=\"176\" y=\"14\" font-size=\"12\" font-weight=\"700\" fill=\"var(--tide-ink)\">now</text><line x1=\"0\" y1=\"184\" x2=\"304\" y2=\"184\" stroke=\"var(--tide-rule)\"/><text x=\"60\" y=\"202\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--tide-muted)\">10 AM</text><text x=\"200\" y=\"202\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--tide-muted)\">2 PM</text></svg><figcaption>Solid: readings. Dashed: the model's projected path to target, not a range.</figcaption></figure>",
      "css": ":host{--tide-band:#f2c230;--tide-on-band:#13233a;--tide-ground:#f5f6f2;--tide-ink:#13233a;--tide-muted:#566273;--tide-rule:#cdd2d8;--tide-blue:#2e6db4;--tide-pull:#c8372d;--tide-on-pull:#fff7f5;font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-chart{margin:0;padding:20px;background:var(--tide-ground);}.ds-chart svg{display:block;overflow:visible;font-family:Archivo,system-ui,sans-serif;}.ds-chart figcaption{margin-top:8px;font-size:13px;color:var(--tide-muted);}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Bottom tab bar (phone) / 88px rail (desktop); active tab gets a band-colored marker and filled icon.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item is-active\" aria-current=\"page\"><span class=\"ds-mark\"></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M152,150.64V40a24,24,0,0,0-48,0V150.64a48,48,0,1,0,48,0Z\"/></svg>Cook</button><button class=\"ds-nav-item\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M136,80v43.47l36.12,21.67a8,8,0,0,1-8.24,13.72l-40-24A8,8,0,0,1,120,128V80a8,8,0,0,1,16,0Zm-8-48A95.44,95.44,0,0,0,60.08,60.15C52.81,67.51,46.35,74.59,40,82V64a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H72a8,8,0,0,0,0-16H49c7.15-8.42,14.27-16.35,22.39-24.57a80,80,0,1,1,1.66,114.75,8,8,0,1,0-11,11.64A96,96,0,1,0,128,32Z\"/></svg>History</button></nav>",
